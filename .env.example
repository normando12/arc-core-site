# Hardhat — Arc Testnet deployer key (never commit real .env)
# Official network: https://docs.arc.network/integrate/connect-to-arc
#   Chain ID 5042002 · RPC https://rpc.testnet.arc.network · Symbol USDC · Explorer https://testnet.arcscan.app
PRIVATE_KEY=0x_your_hex_key_without_quotes

# Optional override (defaults to official RPC)
# ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Optional: override on-chain contract from generated files (browser)
# NEXT_PUBLIC_ARC_GOVERNANCE_ADDRESS=0x...

# If you ran deploy against the local Hardhat network for a smoke test,
# reset the committed stub address with: npm run contracts:codegen

# Optional: overrides default `public/sounds/arc audio.mp4` after each confirmed tx
# NEXT_PUBLIC_TX_SUCCESS_SOUND_URL=/sounds/outro.mp3

# Optional: WalletConnect (else injected / MetaMask only)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Dev — permitir acesso pelo IP da máquina na LAN (evita 403 em assets do Next)
# Ex.: NEXT_ALLOWED_DEV_ORIGINS=192.168.1.7
# Depois: npm run dev:host e abra http://SEU_IP:3000 no celular/outro PC

# Vercel — em Project → Settings → Environment Variables (Production/Preview):
#   copie os mesmos NEXT_PUBLIC_* que precisar; nunca coloque PRIVATE_KEY na Vercel.
# Vercel: Root Directory pode ficar em "." (raiz); Next.js está na raiz deste repo.
# CLI (raiz do repo): npm run vercel:login → npm run vercel:link → npm run vercel:prod
